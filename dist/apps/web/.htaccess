<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# SPA fallback: route everything that is not a real file/dir to index.html
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]
</IfModule>

# Force UTF-8 so all 8 languages render correctly
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
	Header set X-Powered-By "Hostinger Horizons"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

	# Cache everything on CDN by default
	Header set Cache-Control "public, s-maxage=604800, max-age=0"

	# Cache in browser all assets (Vite filenames are content-hashed)
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header set Cache-Control "public, max-age=604800, immutable"
	</If>

	# Never cache the SPA shell or SEO files
	<If "%{REQUEST_URI} =~ m#^/(index\.html|robots\.txt|sitemap\.xml|llms\.txt)?$#">
		Header set Cache-Control "public, max-age=0, must-revalidate"
	</If>
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>